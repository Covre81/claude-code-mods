#!/bin/sh
# Testa lixeira.sh com um gio falso. `claude plugin test` só roda TypeScript, por isso este fica à parte:
#   sh lixeira/hooks/lixeira.sh.test [caminho/do/lixeira.sh]
set -u
SCRIPT=${1:-$(dirname "$0")/lixeira.sh}
W=$(mktemp -d); SHM=$(mktemp -d -p /dev/shm); trap 'rm -rf "$W" "$SHM"' EXIT
mkdir "$W/bin" "$W/trash"
cat > "$W/bin/gio" <<EOF
#!/bin/sh
[ "\$FAKE_GIO" = ok ] && mv -- "\$2" "$W/trash/" && exit 0
echo "gio: Can't move to Rubbish Bin on system internal mounts" >&2; exit 1
EOF
chmod +x "$W/bin/gio"
fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }

touch "$SHM/a" "$SHM/b"
PATH="$W/bin:$PATH" FAKE_GIO=ok sh "$SCRIPT" "$SHM/a" "$SHM/b" 2>"$W/err"; st=$?
check "gio aceita: status 0" '[ $st = 0 ]'
check "gio aceita: itens na lixeira" '[ -e "$W/trash/a" ] && [ -e "$W/trash/b" ]'
check "gio aceita: resumo com a contagem" 'grep -q "2 itens enviados para a lixeira" "$W/err"'

touch "$SHM/c"
PATH="$W/bin:$PATH" FAKE_GIO=no sh "$SCRIPT" "$SHM/c" 2>"$W/err"; st=$?
check "gio recusa fora do /tmp: status 1" '[ $st = 1 ]'
check "gio recusa fora do /tmp: nada apagado" '[ -e "$SHM/c" ]'
check "gio recusa fora do /tmp: sem resumo de envio" '! grep -q "enviado" "$W/err"'

T=$(mktemp -p /tmp)
PATH="$W/bin:$PATH" FAKE_GIO=no sh "$SCRIPT" "$T" 2>"$W/err"; st=$?
check "/tmp: apagado de vez, status 0" '[ $st = 0 ] && [ ! -e "$T" ]'
check "/tmp: resumo diz que foi de vez" 'grep -q "1 apagado(s) de vez" "$W/err"'

[ "$fails" = 0 ] && echo "todos passaram" || { echo "$fails falha(s)"; exit 1; }
